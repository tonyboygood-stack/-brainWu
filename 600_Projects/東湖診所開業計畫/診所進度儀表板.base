filters:
  and:
    - file.inFolder("600_Projects/東湖診所開業計畫/tasks")
formulas:
  is_done: if(status == "🟢 完成", 1, 0)
properties:
  area:
    displayName: 方面
  status:
    displayName: 狀態
  note.area:
    displayName: 方面
  note.status:
    displayName: 狀態
  note.目標:
    displayName: 目標
  note.時間:
    displayName: 時間
  note.優先度:
    displayName: 優先度
views:
  - type: hans-kanban-view
    name: 看板總覽
    order:
      - 時間
      - 優先度
    groupByProperty: note.area
    cardColorProperty: note.status
    cardColorOrder:
      - 🔴 待辦
      - 🟡 進行中
      - 🟢 完成
    cardTitleProperty: note.目標
    cardSelectOptions:
      note.優先度:
        - ⭐⭐⭐⭐⭐
        - ⭐⭐⭐⭐
        - ⭐⭐⭐
        - ⭐⭐
        - ⭐
      note.時間:
        - 今天必達
        - 本週目標
        - 本月目標
        - 本季目標
        - 未分類
    wrapPropertyValues: true
    minimalMode: true
    columnOrders:
      note.area:
        - 法規與行政
        - 人員招募
        - 財務
        - 品牌與行銷／醫療服務
        - 時程與交接
        - 電費
        - 裝修前必辦
        - 裝修期間
        - 開業後每年例行
  - type: hans-kanban-view
    name: 每日工作台
    order:
      - area
      - 優先度
    groupByProperty: note.時間
    cardColorProperty: note.狀態
    cardColorOrder:
      - 🟤 未開始
      - 🔴 進行中
      - 🟡 25%
      - 🔵 50%
      - 🟣 75%
      - 🩵 90%
      - 🩷 99%
      - 🟢 100%
      - ⚪ 已交付
      - 🟤 可以封存
    cardTitleProperty: note.目標
    cardSelectOptions:
      note.優先度:
        - ⭐⭐⭐⭐⭐
        - ⭐⭐⭐⭐
        - ⭐⭐⭐
        - ⭐⭐
        - ⭐
    wrapPropertyValues: true
    minimalMode: true
    columnOrders:
      note.時間:
        - 專案列表
        - 今天必達
        - 本週目標
        - 本月目標
        - 本季目標
        - 未分類
    cardOrders:
      note.時間: {}
      note.狀態: {}
    columnColors:
      note.時間:
        今天必達: red
        本週目標: orange
        本月目標: yellow
      note.狀態: {}
    columnWidths:
      note.時間: {}
      note.狀態: {}
    cardColors:
      note.狀態:
        🟤 未開始: brown
        🔴 進行中: red
        🟡 25%: yellow
        🔵 50%: blue
        🟣 75%: purple
        🩵 90%: cyan
        🩷 99%: pink
        🟢 100%: green
        ⚪ 已交付: gray
        🟤 可以封存: brown
    quickAddFolder: B1_個人策略/5-主線看板
    hideEmptyColumns: false
    columnWidth: 260
    masonryMode: false
    sort:
      - property: 優先度
        direction: DESC
    inheritedFrom: template:每日工作台
  - type: table
    name: 總覽
    groupBy:
      property: area
      direction: ASC
    order:
      - file.name
      - 目標
      - status
      - 時間
      - 優先度
    summaries:
      formula.is_done: Average
  - type: table
    name: 代辦看板
    filters:
      and:
        - status != "🟢 完成"
    groupBy:
      property: area
      direction: ASC
    order:
      - file.name
      - 目標
      - status
      - 時間
      - 優先度
  - type: table
    name: 已完成紀錄
    filters:
      and:
        - status == "🟢 完成"
    groupBy:
      property: area
      direction: ASC
    order:
      - file.name
      - 目標
      - status
