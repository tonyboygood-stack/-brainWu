filters:
  and:
    - file.inFolder("600_Projects/東湖診所開業計畫/tasks")

formulas:
  is_done: 'if(status == "🟢 完成", 1, 0)'

properties:
  area:
    displayName: "方面"
  status:
    displayName: "狀態"
  note.area:
    displayName: "方面"
  note.status:
    displayName: "狀態"
  note.目標:
    displayName: "目標"
  note.時間:
    displayName: "時間"
  note.優先度:
    displayName: "優先度"

views:
  - type: hans-kanban-view
    name: "看板總覽"
    order:
      - 時間
      - 優先度
    groupByProperty: note.area
    cardColorProperty: note.status
    cardColorOrder:
      - 🔴 待辦
      - 🟡 進行中
      - 🟢 完成
    cardTitleProperty: note.目標
    cardSelectOptions:
      note.優先度:
        - ⭐⭐⭐⭐⭐
        - ⭐⭐⭐⭐
        - ⭐⭐⭐
        - ⭐⭐
        - ⭐
    wrapPropertyValues: true
    minimalMode: true
    columnOrders:
      note.area:
        - 法規與行政
        - 人員招募
        - 品牌與行銷／醫療服務
        - 時程與交接
        - 電費
        - 裝修前必辦
        - 裝修期間
        - 開業後每年例行

  - type: table
    name: "總覽"
    groupBy:
      property: area
      direction: ASC
    order:
      - file.name
      - 目標
      - status
      - 時間
      - 優先度
    summaries:
      formula.is_done: Average

  - type: table
    name: "代辦看板"
    filters:
      and:
        - 'status != "🟢 完成"'
    groupBy:
      property: area
      direction: ASC
    order:
      - file.name
      - 目標
      - status
      - 時間
      - 優先度

  - type: table
    name: "已完成紀錄"
    filters:
      and:
        - 'status == "🟢 完成"'
    groupBy:
      property: area
      direction: ASC
    order:
      - file.name
      - 目標
      - status
