filters:
  or:
    - file.hasProperty("學習狀態")
    - file.inFolder("500_Inbox")
formulas:
  躺了幾天: (now() - file.mtime).days
  已收成: if(學習狀態 == "🟢 已用於臨床", 1, 0)
properties:
  學習狀態:
    displayName: 學習狀態
  醫家:
    displayName: 來源／醫家
  source_type:
    displayName: 素材類型
  note.學習狀態:
    displayName: 學習狀態
  note.醫家:
    displayName: 來源／醫家
  note.source_type:
    displayName: 素材類型
  formula.躺了幾天:
    displayName: 躺了幾天
  formula.已收成:
    displayName: 已收成
views:
  - type: hans-kanban-view
    name: 學習管線
    filters:
      and:
        - file.hasProperty("學習狀態")
    order:
      - 醫家
      - source_type
    groupByProperty: note.學習狀態
    cardColorProperty: note.學習狀態
    cardColorOrder:
      - 🔴 想讀
      - 🟠 讀了待補筆記
      - 🟡 待整理成卡
      - 🩵 已成卡
      - 🟢 已用於臨床
    cardSelectOptions:
      note.學習狀態:
        - 🔴 想讀
        - 🟠 讀了待補筆記
        - 🟡 待整理成卡
        - 🩵 已成卡
        - 🟢 已用於臨床
    wrapPropertyValues: true
    minimalMode: true
    columnOrders:
      note.學習狀態:
        - 🔴 想讀
        - 🟠 讀了待補筆記
        - 🟡 待整理成卡
        - 🩵 已成卡
        - 🟢 已用於臨床
  - type: hans-kanban-view
    name: 依來源
    filters:
      and:
        - file.hasProperty("學習狀態")
    order:
      - 學習狀態
      - source_type
    groupByProperty: note.醫家
    cardColorProperty: note.學習狀態
    cardColorOrder:
      - 🔴 想讀
      - 🟠 讀了待補筆記
      - 🟡 待整理成卡
      - 🩵 已成卡
      - 🟢 已用於臨床
    cardSelectOptions:
      note.學習狀態:
        - 🔴 想讀
        - 🟠 讀了待補筆記
        - 🟡 待整理成卡
        - 🩵 已成卡
        - 🟢 已用於臨床
    wrapPropertyValues: true
    minimalMode: true
    columnOrders:
      note.醫家:
        - 趙紹琴
    cardOrders:
      note.醫家: {}
    columnColors:
      note.醫家: {}
    columnWidths:
      note.醫家:
        趙紹琴: 223
    cardColors:
      note.學習狀態: {}
  - type: hans-kanban-view
    name: 依素材類型
    filters:
      and:
        - file.hasProperty("學習狀態")
    order:
      - 學習狀態
      - 醫家
    groupByProperty: note.source_type
    cardColorProperty: note.學習狀態
    cardColorOrder:
      - 🔴 想讀
      - 🟠 讀了待補筆記
      - 🟡 待整理成卡
      - 🩵 已成卡
      - 🟢 已用於臨床
    cardSelectOptions:
      note.學習狀態:
        - 🔴 想讀
        - 🟠 讀了待補筆記
        - 🟡 待整理成卡
        - 🩵 已成卡
        - 🟢 已用於臨床
    wrapPropertyValues: true
    minimalMode: true
    columnOrders:
      note.source_type:
        - 醫案
        - 病機病理
        - 治法技法
        - 方劑
        - 藥物本草
        - 典籍
        - 診斷評估
        - 解剖生理
        - 辨析
        - 醫家
  - type: table
    name: 積壓區
    filters:
      and:
        - file.inFolder("500_Inbox")
        - file.ext == "md"
    order:
      - file.name
      - formula.躺了幾天
      - 學習狀態
      - file.mtime
  - type: table
    name: 總覽
    filters:
      and:
        - file.hasProperty("學習狀態")
    groupBy:
      property: 學習狀態
      direction: ASC
    order:
      - file.name
      - 學習狀態
      - 醫家
      - source_type
      - formula.躺了幾天
    summaries:
      formula.已收成: Average
