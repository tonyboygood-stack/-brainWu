filters:
  and:
    - file.inFolder("400_Atlas/Notes")
    - type == "personal-clinical-knowledge"
formulas:
  停留天數: (now() - file.mtime).days
properties:
  knowledge_stage:
    displayName: 成長階段
  knowledge_type:
    displayName: 知識類型
  says:
    displayName: 目前核心
  source_page:
    displayName: 起點來源
  primary_layer:
    displayName: 框架主層
  updated:
    displayName: 更新日期
  formula.停留天數:
    displayName: 停留天數
views:
  - type: hans-kanban-view
    name: 知識成長
    order:
      - knowledge_type
      - primary_layer
      - updated
    groupByProperty: note.knowledge_stage
    cardColorProperty: note.knowledge_stage
    cardColorOrder:
      - 🟤 待澆水
      - 🔵 待我理解
      - 🌸 延伸中
      - 🟢 已整合
    cardSelectOptions:
      note.knowledge_stage:
        - 🟤 待澆水
        - 🔵 待我理解
        - 🌸 延伸中
        - 🟢 已整合
    wrapPropertyValues: true
    minimalMode: true
    columnOrders:
      note.knowledge_stage:
        - 🟤 待澆水
        - 🔵 待我理解
        - 🌸 延伸中
        - 🟢 已整合
        - 未分類
  - type: table
    name: 待我理解
    filters:
      and:
        - knowledge_stage == "🔵 待我理解"
    order:
      - file.name
      - says
      - knowledge_type
      - source_page
      - formula.停留天數
  - type: table
    name: 已整合
    filters:
      and:
        - knowledge_stage == "🟢 已整合"
    order:
      - file.name
      - says
      - knowledge_type
      - primary_layer
      - updated
